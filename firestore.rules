rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Keep in sync with ADMIN_EMAILS in src/lib/admin.js — this is the actual
    // enforcement; the client-side check just keeps non-admins from seeing the page.
    function isAdmin() { return signedIn() && request.auth.token.email == 'demo@peerlink.app'; }

    // A user can always write their own profile. The admin page's edit/lock/delete
    // actions need to write *someone else's*, so admins can too.
    match /users/{userId} {
      allow read: if signedIn();
      allow write, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /teachingSubjects/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /availability/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /learningRequests/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Doc id is the matchId (`${requestId}--${tutorId}`) — set by the student.
    match /matchRequests/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && resource.data.tutorId == request.auth.uid;
    }

    // Doc id is the matchId it was arranged from — only the two people in that match can write it.
    match /sessions/{matchId} {
      allow read: if signedIn();
      allow write: if signedIn() &&
        exists(/databases/$(database)/documents/matchRequests/$(matchId)) &&
        (get(/databases/$(database)/documents/matchRequests/$(matchId)).data.tutorId == request.auth.uid ||
         get(/databases/$(database)/documents/matchRequests/$(matchId)).data.studentId == request.auth.uid);
    }

    match /feedback/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    // Pre-imported roster used to auto-fill name/course at registration — read
    // has to be public since that happens before an account exists. Only
    // non-sensitive fields belong here (no email/contact info) for that reason.
    match /studentDirectory/{adminNo} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // One-off extra classes a "teacher" (any signed-in user) opens; anyone can
    // register interest. Doc id for interests is `${classId}--${userId}`.
    match /classSessions/{classId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.teacherId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.teacherId == request.auth.uid;
    }

    match /classInterests/{interestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
