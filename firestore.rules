rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    // Two sources: the hardcoded bootstrap list (keep in sync with ADMIN_EMAILS in
    // src/lib/admin.js — needed so there's always at least one admin even with an
    // empty adminEmails collection) and the adminEmails collection managed from the
    // admin page UI. Either one grants admin. This is the actual enforcement; the
    // client-side check just keeps non-admins from seeing the page.
    function isAdmin() {
      return signedIn() && (
        request.auth.token.email in ['demo@peerlink.app', 'runrampage3@gmail.com'] ||
        exists(/databases/$(database)/documents/adminEmails/$(request.auth.token.email))
      );
    }

    match /adminEmails/{email} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }

    // A user can always write their own profile. The admin page's edit/lock/delete
    // actions need to write *someone else's*, so admins can too.
    match /users/{userId} {
      allow read: if signedIn();
      allow write, delete: if signedIn() && (request.auth.uid == userId || isAdmin());
    }

    match /teachingSubjects/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /availability/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /learningRequests/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Doc id is the matchId (`${requestId}--${tutorId}`) — set by the student.
    match /matchRequests/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && (resource.data.tutorId == request.auth.uid || isAdmin());
    }

    // Doc id is the matchId it was arranged from — only the two people in that match (or an admin) can write it.
    match /sessions/{matchId} {
      allow read: if signedIn();
      allow write: if signedIn() && (
        isAdmin() ||
        (exists(/databases/$(database)/documents/matchRequests/$(matchId)) &&
         (get(/databases/$(database)/documents/matchRequests/$(matchId)).data.tutorId == request.auth.uid ||
          get(/databases/$(database)/documents/matchRequests/$(matchId)).data.studentId == request.auth.uid))
      );
    }

    match /feedback/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    // Pre-imported roster used to auto-fill name/course at registration — read
    // has to be public since that happens before an account exists. Only
    // non-sensitive fields belong here (no email/contact info) for that reason.
    match /studentDirectory/{adminNo} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // A student requests help with a module; once enough interest piles up, a
    // tutor who teaches it claims the request (status -> 'scheduled'). That
    // claiming tutor isn't the creator, and there's no clean way to check
    // "is a qualified tutor for this module" from rules without deterministic
    // doc ids on teachingSubjects — so update is any signed-in user for now,
    // same trade-off as elsewhere in this file. Doc id for interests is
    // `${requestId}--${userId}`.
    match /classRequests/{requestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn();
      allow delete: if signedIn() && (resource.data.studentId == request.auth.uid || isAdmin());
    }

    match /classInterests/{interestId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow delete: if signedIn() && resource.data.userId == request.auth.uid;
    }
  }
}
