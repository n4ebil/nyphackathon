rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // A user can always write their own profile. Any signed-in user can also
    // write/delete *someone else's* — needed for the admin page's edit/lock/delete
    // actions, since there's no admin/HR role yet (same gap as studentDirectory
    // below). Tighten to a specific allowlisted account before relying on this.
    match /users/{userId} {
      allow read: if signedIn();
      allow write, delete: if signedIn();
    }

    match /teachingSubjects/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /availability/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.userId == request.auth.uid;
    }

    match /learningRequests/{docId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Doc id is the matchId (`${requestId}--${tutorId}`) — set by the student.
    match /matchRequests/{matchId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.studentId == request.auth.uid;
      allow update: if signedIn() && resource.data.tutorId == request.auth.uid;
    }

    // Doc id is the matchId it was arranged from — only the two people in that match can write it.
    match /sessions/{matchId} {
      allow read: if signedIn();
      allow write: if signedIn() &&
        exists(/databases/$(database)/documents/matchRequests/$(matchId)) &&
        (get(/databases/$(database)/documents/matchRequests/$(matchId)).data.tutorId == request.auth.uid ||
         get(/databases/$(database)/documents/matchRequests/$(matchId)).data.studentId == request.auth.uid);
    }

    match /feedback/{docId} {
      allow read: if signedIn();
      allow create: if signedIn();
    }

    // Pre-imported roster used to auto-fill name/course at registration — read
    // has to be public since that happens before an account exists. Only
    // non-sensitive fields belong here (no email/contact info) for that reason.
    // Write is open to any signed-in user for now (no admin/HR role exists yet) —
    // tighten this to a specific allowlisted account before relying on it for real.
    match /studentDirectory/{adminNo} {
      allow read: if true;
      allow write: if signedIn();
    }
  }
}
